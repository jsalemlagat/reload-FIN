rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isWorkspaceMember(workspaceId) {
      return isSignedIn() && exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
    }

    function getWorkspaceMember(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data;
    }

    function isWorkspaceAdmin(workspaceId) {
      return isWorkspaceMember(workspaceId) && getWorkspaceMember(workspaceId).role == 'admin';
    }

    function isWorkspaceEncoder(workspaceId) {
      return isWorkspaceMember(workspaceId) && (getWorkspaceMember(workspaceId).role in ['admin', 'encoder']);
    }

    function isValidWorkspace(data) {
      return data.keys().hasAll(['id', 'name', 'teamCode', 'ownerUid', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.name is string && data.name.size() <= 100 &&
        data.teamCode is string && data.teamCode.size() <= 30 &&
        data.ownerUid is string && data.ownerUid.size() <= 128;
    }

    function isValidMember(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'joinedAt']) &&
        data.uid is string && data.uid.size() <= 128 &&
        data.email is string && data.email.size() <= 200 &&
        data.displayName is string && data.displayName.size() <= 100 &&
        (data.role in ['admin', 'encoder', 'viewer']);
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['id', 'type', 'amount', 'whatPurchased', 'account', 'category', 'date', 'loggedBy', 'encoderUid', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        (data.type in ['inflow', 'outflow']) &&
        data.amount is number && data.amount >= 0 &&
        data.whatPurchased is string && data.whatPurchased.size() <= 500 &&
        data.account is string && data.account.size() <= 100 &&
        data.category is string && data.category.size() <= 100 &&
        data.date is string && data.date.size() <= 30 &&
        data.loggedBy is string && data.loggedBy.size() <= 100 &&
        data.encoderUid is string && data.encoderUid.size() <= 128;
    }

    function isValidComment(data) {
      return data.keys().hasAll(['id', 'transactionId', 'authorUid', 'authorName', 'content', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.transactionId is string && data.transactionId.size() <= 128 &&
        data.authorUid is string && data.authorUid.size() <= 128 &&
        data.authorName is string && data.authorName.size() <= 100 &&
        data.content is string && data.content.size() <= 1000;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['id', 'type', 'title', 'message', 'actorUid', 'actorName', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        (data.type in ['entry_created', 'comment_reply']) &&
        data.title is string && data.title.size() <= 200 &&
        data.message is string && data.message.size() <= 500 &&
        data.actorUid is string && data.actorUid.size() <= 128 &&
        data.actorName is string && data.actorName.size() <= 100;
    }

    // Workspaces
    match /workspaces/{workspaceId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(workspaceId) && isValidWorkspace(incoming()) && incoming().ownerUid == request.auth.uid;
      allow update: if isWorkspaceAdmin(workspaceId) && isValidWorkspace(incoming()) && incoming().ownerUid == existing().ownerUid;
      allow delete: if false;

      // Workspace Members
      match /members/{memberId} {
        allow get: if isWorkspaceMember(workspaceId) || request.auth.uid == memberId;
        allow list: if isWorkspaceMember(workspaceId) || isSignedIn();
        // Allow user to join workspace as member or admin to add
        allow create: if isSignedIn() && isValidId(memberId) && isValidMember(incoming()) && (
          // Admin can add members
          isWorkspaceAdmin(workspaceId) ||
          // User can register themselves with valid member data
          (request.auth.uid == memberId && (incoming().role == 'viewer' || incoming().role == 'encoder' || (request.auth.token.email == 'thejscl@gmail.com' && incoming().role == 'admin')))
        );
        allow update: if isWorkspaceAdmin(workspaceId) && isValidMember(incoming()) && incoming().uid == existing().uid;
        allow delete: if isWorkspaceAdmin(workspaceId) && memberId != request.auth.uid;
      }

      // Transactions
      match /transactions/{transactionId} {
        allow get: if isWorkspaceMember(workspaceId);
        allow list: if isWorkspaceMember(workspaceId);
        allow create: if isWorkspaceEncoder(workspaceId) && isValidId(transactionId) && isValidTransaction(incoming()) && incoming().encoderUid == request.auth.uid;
        allow update: if isValidTransaction(incoming()) && incoming().encoderUid == existing().encoderUid && (
          isWorkspaceAdmin(workspaceId) ||
          (isWorkspaceEncoder(workspaceId) && existing().encoderUid == request.auth.uid)
        );
        allow delete: if isWorkspaceAdmin(workspaceId);

        // Transaction Comments
        match /comments/{commentId} {
          allow get: if isWorkspaceMember(workspaceId);
          allow list: if isWorkspaceMember(workspaceId);
          allow create: if isWorkspaceEncoder(workspaceId) && isValidId(commentId) && isValidComment(incoming()) && incoming().authorUid == request.auth.uid &&
            exists(/databases/$(database)/documents/workspaces/$(workspaceId)/transactions/$(transactionId));
          allow update: if isWorkspaceMember(workspaceId) && isValidComment(incoming()) && incoming().authorUid == existing().authorUid && existing().authorUid == request.auth.uid;
          allow delete: if isWorkspaceAdmin(workspaceId) || (isWorkspaceMember(workspaceId) && existing().authorUid == request.auth.uid);
        }
      }

      // Real-time Push Notifications
      match /notifications/{notificationId} {
        allow get: if isWorkspaceMember(workspaceId);
        allow list: if isWorkspaceMember(workspaceId);
        allow create: if isWorkspaceMember(workspaceId) && isValidId(notificationId) && isValidNotification(incoming()) && incoming().actorUid == request.auth.uid;
        allow update: if isWorkspaceMember(workspaceId);
        allow delete: if isWorkspaceAdmin(workspaceId);
      }
    }
  }
}
